use nix

# Automatically configure Git hooks on cd
if [ "$(git config core.hooksPath)" != ".githooks" ]; then
  git config core.hooksPath .githooks
fi

# Automatically provision Beads issue tracking on cd into the repo.
# --skip-agents skips bd's AGENTS.md/CLAUDE.md/.codex/.claude generation: dotfiles
# already deploys equivalent agent instructions globally, so a per-repo copy would
# just be a stale duplicate. Lives here, not shell.nix: `bd` is personal machine
# tooling (a dotfiles-flake package), not a nixpkgs project dependency.
if command -v bd >/dev/null 2>&1; then
  bd init --skip-agents --init-if-missing --non-interactive
fi
